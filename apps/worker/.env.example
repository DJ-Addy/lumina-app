# Lumina Worker — copy to .env (never commit .env)

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=redis://localhost:6379

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

NODE_ENV=development
CONCURRENCY=5

# Auto-moderation (defaults match app behavior)
REPORT_DELETE_THRESHOLD=7
VIOLATION_SUSPEND_THRESHOLD=3

# Optional SMTP for violation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Lumina Trust & Safety <noreply@lumina.app>
APP_URL=https://lumina.app

SENTRY_DSN=
