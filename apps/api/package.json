{
  "name": "@lumina/api",
  "version": "0.0.1",
  "private": true,
  "description": "Lumina Fastify REST API",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
