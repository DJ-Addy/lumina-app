# Lumina Mobile (Expo) — copy to .env
# Expo loads EXPO_PUBLIC_* at bundle time; restart Metro after changes.

# Required for auth + Supabase client
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required for API calls from a real device (use your PC LAN IP, not localhost)
# Example: http://192.168.1.50:3000
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:3000

# Optional
EXPO_PUBLIC_SENTRY_DSN=
