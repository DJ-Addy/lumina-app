    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@google/generative-ai": "^0.24.1",
    "@lumina/shared": "workspace:*",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.47.0",
    "astronomy-engine": "^2.1.19",
    "bullmq": "^5.0.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.4.0",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
