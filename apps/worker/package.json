    "@lumina/shared": "workspace:*",
    "@react-pdf/renderer": "^4.1.0",
    "@sentry/node": "^8.0.0",
    "@supabase/supabase-js": "^2.47.0",
    "bullmq": "^5.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.4.0",
    "nodemailer": "^8.0.5",
    "openai": "^4.77.0",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
