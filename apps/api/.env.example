# Lumina API — copy to .env and fill in values (never commit .env)

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=redis://localhost:6379

# At least 32 random characters
JWT_SECRET=replace-with-32-plus-char-secret-for-local-dev-only

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
REVENUECAT_WEBHOOK_TOKEN=

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated origins or single URL for Expo web / Metro
CORS_ORIGIN=http://localhost:8081
